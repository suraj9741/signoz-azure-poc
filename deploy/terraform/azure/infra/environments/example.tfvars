# Template for a new region or account. Copy to environments/<name>.tfvars and edit.
# Secrets are generated by Terraform into this deployment's Key Vault — never put them here.

subscription_id = "<subscription-id>"
# tenant_id     = "<tenant-id>"   # optional; defaults to the current az login tenant

project     = "sigpoc" # 2-8 lowercase letters/digits
environment = "dev"   # 2-6 lowercase letters/digits

location               = "westeurope"
location_short         = "weu"
support_location       = "northeurope" # same as location is fine if vCPU quota allows
support_location_short = "neu"

# Must not overlap each other or any network you will peer with.
vnet_address_space = "10.40.0.0/16"
subnet_prefixes = {
  bastion           = "10.40.0.0/26"
  signoz            = "10.40.1.0/24"
  app_integration   = "10.40.2.0/26"
  private_endpoints = "10.40.3.0/27"
}
support_vnet_address_space = "10.50.0.0/16"
support_subnet_prefix      = "10.50.1.0/24"

signoz_vm_size        = "Standard_B4as_v2"
signoz_vm_private_ip  = "10.40.1.10"
support_vm_size       = "Standard_B2s_v2"
support_vm_private_ip = "10.50.1.10"

enable_bastion    = true
enable_support_vm = true

# Optional overrides (defaults shown in variables.tf):
# bastion_sku     = "Standard"
# app_service_sku = "B1"
# sql_sku         = "Basic"
# eventhub_sku    = "Standard"
# acr_sku         = "Basic"

auto_shutdown_time     = "1900"
auto_shutdown_timezone = "India Standard Time"

owner      = "<owner>"
expiry     = "YYYY-MM-DD"
extra_tags = {}

# Phase 2 (after the image is pushed to this deployment's ACR):
# app_image         = "dqlite-api:v1"
# otel_service_name = "dqlite-api"
# otel_tenant     = "demo"
